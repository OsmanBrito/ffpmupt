rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'superadmin'
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.enabled == true;
    }

    function isEnabledCountry(countryCode) {
      return exists(
          /databases/$(database)/documents/countries/$(countryCode)
        )
        && get(
          /databases/$(database)/documents/countries/$(countryCode)
        ).data.enabled == true;
    }

    function isCountryAdmin(countryCode) {
      return isSuperAdmin()
        || (isSignedIn()
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.enabled == true
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.countryCodes.hasAny([countryCode]));
    }

    function isValidCountryDocument(countryCode) {
      return request.resource.data.code == countryCode
        && request.resource.data.code == resource.data.code
        && request.resource.data.enabled == resource.data.enabled
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.defaultLanguage is string
        && request.resource.data.defaultLanguage.size() >= 2
        && request.resource.data.defaultLanguage.size() <= 5
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() >= 1
        && request.resource.data.timezone.size() <= 100
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'defaultLanguage', 'timezone', 'updatedAt'
        ]);
    }

    function isValidNoticeDocument(countryCode) {
      return request.resource.data.countryCode == countryCode
        && request.resource.data.enabled is bool
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 10000
        && request.resource.data.category in [
          'general', 'event', 'specialDay', 'workshop', 'weeklyHomework'
        ]
        && request.resource.data.date is string
        && (request.resource.data.date == ''
          || request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 300
        && request.resource.data.linkUrl is string
        && request.resource.data.linkUrl.size() <= 2048
        && (request.resource.data.linkUrl == ''
          || request.resource.data.linkUrl.matches('^https://.+$'))
        && (!request.resource.data.keys().hasAny(['imageUrl'])
          || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 2048
            && (request.resource.data.imageUrl == ''
              || request.resource.data.imageUrl.matches(
                '^https://res[.]cloudinary[.]com/.+$'
              ))))
        && request.resource.data.languageCode is string
        && request.resource.data.languageCode.matches('^[a-z]{2,5}(-[a-z]{2,5})?$')
        && request.resource.data.pinned is bool
        && request.resource.data.sortOrder is int;
    }

    function isInviteEmail(invite) {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == invite.email;
    }

    function isValidInviteProfileCreate(userId) {
      let invite = getAfter(
        /databases/$(database)/documents/adminInvites/$(request.resource.data.lastInviteId)
      ).data;
      return request.auth.uid == userId
        && request.auth.token.email_verified == true
        && isInviteEmail(invite)
        && invite.enabled == false
        && invite.acceptedBy == userId
        && invite.expiresAt > request.time
        && request.resource.data.role == 'admin'
        && request.resource.data.enabled == true
        && request.resource.data.email == invite.email
        && request.resource.data.displayName == invite.displayName
        && request.resource.data.countryCodes.toSet() == invite.countryCodes.toSet()
        && request.resource.data.keys().hasAll([
          'email', 'displayName', 'role', 'enabled', 'countryCodes',
          'lastInviteId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'enabled', 'countryCodes',
          'lastInviteId', 'createdAt', 'updatedAt'
        ]);
    }

    function isValidInviteProfileUpdate(userId) {
      let invite = getAfter(
        /databases/$(database)/documents/adminInvites/$(request.resource.data.lastInviteId)
      ).data;
      return request.auth.uid == userId
        && request.auth.token.email_verified == true
        && resource.data.role == 'admin'
        && isInviteEmail(invite)
        && invite.enabled == false
        && invite.acceptedBy == userId
        && invite.expiresAt > request.time
        && request.resource.data.role == 'admin'
        && request.resource.data.enabled == resource.data.enabled
        && request.resource.data.email == invite.email
        && request.resource.data.displayName == invite.displayName
        && request.resource.data.countryCodes.toSet()
          == resource.data.countryCodes.toSet().union(invite.countryCodes.toSet())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'countryCodes', 'lastInviteId', 'updatedAt'
        ]);
    }

    match /countries/{countryCode} {
      // Public country discovery must only expose active countries. Admins
      // can still open their own country, including while it is being prepared
      // or temporarily disabled.
      allow read: if resource.data.enabled == true
        || isSuperAdmin()
        || isCountryAdmin(countryCode);
      allow create: if isSuperAdmin()
        && request.resource.data.code == countryCode
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.defaultLanguage is string
        && request.resource.data.timezone is string
        && request.resource.data.enabled is bool;
      allow update: if isSuperAdmin()
        || (isCountryAdmin(countryCode) && isValidCountryDocument(countryCode));
      allow delete: if false;
    }

    match /countries/{countryCode}/settings/weeklyVideos {
      allow read: if isEnabledCountry(countryCode) || isCountryAdmin(countryCode);
      allow create, update: if isCountryAdmin(countryCode);
      allow delete: if false;
    }

    match /countries/{countryCode}/settings/payments {
      allow read: if isEnabledCountry(countryCode) || isCountryAdmin(countryCode);
      allow create, update: if isCountryAdmin(countryCode);
      allow delete: if false;
    }

    match /countries/{countryCode}/settings/motto {
      allow read: if isEnabledCountry(countryCode) || isCountryAdmin(countryCode);
      allow create, update: if isCountryAdmin(countryCode);
      allow delete: if false;
    }

    match /countries/{countryCode}/settings/songImport {
      allow read: if isCountryAdmin(countryCode);
      allow create, update: if isCountryAdmin(countryCode);
      allow delete: if false;
    }

    match /countries/{countryCode}/songs/{songId} {
      allow read: if isEnabledCountry(countryCode) || isCountryAdmin(countryCode);
      allow create, update: if isCountryAdmin(countryCode);
      allow delete: if false;
    }

    match /countries/{countryCode}/promises/{languageCode} {
      allow read: if isEnabledCountry(countryCode) || isCountryAdmin(countryCode);
      allow create, update: if isCountryAdmin(countryCode);
      allow delete: if false;
    }

    match /countries/{countryCode}/notices/{noticeId} {
      allow read: if (resource.data.enabled == true
          && isEnabledCountry(countryCode))
        || isCountryAdmin(countryCode);
      allow create, update: if isCountryAdmin(countryCode)
        && isValidNoticeDocument(countryCode);
      allow delete: if false;
    }

    match /countries/{countryCode}/churches/{churchId} {
      allow read, create, update: if isCountryAdmin(countryCode);
      allow delete: if false;
    }

    match /countries/{countryCode}/holyGrounds/{holyGroundId} {
      allow read: if (resource.data.enabled == true
          && isEnabledCountry(countryCode))
        || isCountryAdmin(countryCode);
      allow create, update: if isCountryAdmin(countryCode)
        && request.resource.data.countryCode == countryCode
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }

    // Keep collection-group reads safe for clients that still use this path.
    // The public Flutter web directory reads each enabled country directly so
    // Firestore can prove the parent-country condition for every query.
    match /{path=**}/holyGrounds/{holyGroundId} {
      allow read: if resource.data.enabled == true
        && resource.data.countryCode is string
        && isEnabledCountry(resource.data.countryCode);
    }

    match /adminInvites/{inviteId} {
      allow get: if isSuperAdmin() || isInviteEmail(resource.data);
      allow list, create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isInviteEmail(resource.data)
          && request.auth.token.email_verified == true
          && resource.data.enabled == true
          && resource.data.acceptedBy == ''
          && resource.data.expiresAt > request.time
          && request.resource.data.enabled == false
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'enabled', 'acceptedBy', 'acceptedAt', 'updatedAt'
          ]));
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSuperAdmin() || isValidInviteProfileCreate(userId);
      allow update: if isSuperAdmin() || isValidInviteProfileUpdate(userId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
